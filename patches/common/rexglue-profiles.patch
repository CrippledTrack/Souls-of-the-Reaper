+// Local profiles: the picker a player signs in with (Diablo III opens the
+// sign-in UI when a controller presses A to join, and player 1 sees it when no
+// profile was given at launch). It lists the profiles not playing yet; a new
+// profile or a new name is typed on the on-screen keyboard.
+class ProfilePickerDialog : public XamDialog {
+ public:
+  enum class Choice { kCancel, kPick, kNew, kRename };
+
+  ProfilePickerDialog(rex::ui::ImGuiDrawer* imgui_drawer, uint32_t user_index,
+                      std::vector<rex::system::xam::ProfileEntry> profiles, std::string error,
+                      size_t selected)
+      : XamDialog(imgui_drawer),
+        title_(fmt::format("Choose a profile: Player {}###profile_picker", user_index + 1)),
+        profiles_(std::move(profiles)),
+        error_(std::move(error)),
+        selected_(std::min(selected, profiles_.size())) {
+    input_ = static_cast<rex::input::InputSystem*>(REX_KERNEL_STATE()->emulator()->input_system());
+    if (input_) {
+      input_->CaptureGamepads(true);
+    }
+  }
+
+  ~ProfilePickerDialog() override {
+    if (input_) {
+      input_->CaptureGamepads(false);
+    }
+  }
+
+  Choice choice() const { return choice_; }
+  // The profile picked or to rename (an index into the list given).
+  size_t index() const { return selected_; }
+
+  void OnDraw(ImGuiIO& io) override {
+    if (!has_opened_) {
+      ImGui::OpenPopup(title_.c_str());
+      has_opened_ = true;
+    }
+    if (!ImGui::BeginPopupModal(title_.c_str(), nullptr, ImGuiWindowFlags_AlwaysAutoResize)) {
+      Close();
+      return;
+    }
+    if (!error_.empty()) {
+      ImGui::TextColored(ImVec4(1.0f, 0.45f, 0.4f, 1.0f), "%s", error_.c_str());
+      ImGui::Spacing();
+    }
+    if (PollGamepad() || PollKeyboard()) {
+      ImGui::EndPopup();
+      return;
+    }
+    // The profiles, then "New profile". A click chooses.
+    const float width = 320.0f;
+    for (size_t i = 0; i <= profiles_.size(); ++i) {
+      const bool is_new = i == profiles_.size();
+      const std::string label =
+          is_new ? std::string("+ New profile##new") : profiles_[i].name + "##p" + std::to_string(i);
+      if (ImGui::Selectable(label.c_str(), i == selected_, 0, ImVec2(width, 0))) {
+        selected_ = i;
+        Finish(is_new ? Choice::kNew : Choice::kPick);
+        ImGui::EndPopup();
+        return;
+      }
+    }
+    ImGui::Spacing();
+    const bool can_rename = selected_ < profiles_.size();
+    if (!can_rename) ImGui::BeginDisabled();
+    if (ImGui::Button("Rename")) {
+      Finish(Choice::kRename);
+      ImGui::EndPopup();
+      return;
+    }
+    if (!can_rename) ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (ImGui::Button("Cancel")) {
+      Finish(Choice::kCancel);
+      ImGui::EndPopup();
+      return;
+    }
+    ImGui::Spacing();
+    ImGui::TextDisabled("A choose   Y rename   B cancel");
+    ImGui::EndPopup();
+  }
+
+ private:
+  void Finish(Choice choice) {
+    choice_ = choice;
+    ImGui::CloseCurrentPopup();
+    Close();
+  }
+
+  void Move(int step) {
+    const size_t count = profiles_.size() + 1;
+    selected_ = (selected_ + count + step) % count;
+  }
+
+  // Acts on the choice for the selected row. True when that closed the dialog.
+  bool Accept() {
+    Finish(selected_ < profiles_.size() ? Choice::kPick : Choice::kNew);
+    return true;
+  }
+
+  bool Rename() {
+    if (selected_ >= profiles_.size()) return false;
+    Finish(Choice::kRename);
+    return true;
+  }
+
+  // Up/Down and Enter/Escape for a player on the keyboard. True when closed.
+  bool PollKeyboard() {
+    if (ImGui::IsKeyPressed(ImGuiKey_UpArrow)) Move(-1);
+    if (ImGui::IsKeyPressed(ImGuiKey_DownArrow)) Move(1);
+    if (ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false)) {
+      return Accept();
+    }
+    if (ImGui::IsKeyPressed(ImGuiKey_F2, false)) return Rename();
+    if (ImGui::IsKeyPressed(ImGuiKey_Escape, false)) {
+      Finish(Choice::kCancel);
+      return true;
+    }
+    return false;
+  }
+
+  // Reads the pads and acts on new presses. True when that closed the dialog.
+  bool PollGamepad() {
+    rex::input::X_INPUT_GAMEPAD pad = {};
+    if (!input_ || !input_->DialogGamepad(&pad)) {
+      held_ = 0;
+      return false;
+    }
+    uint16_t buttons = static_cast<uint16_t>(pad.buttons);
+    constexpr int16_t kStickThreshold = 16000;
+    const auto ly = static_cast<int16_t>(pad.thumb_ly);
+    if (ly > kStickThreshold) buttons |= rex::input::X_INPUT_GAMEPAD_DPAD_UP;
+    if (ly < -kStickThreshold) buttons |= rex::input::X_INPUT_GAMEPAD_DPAD_DOWN;
+    // The press that opened the picker (the join) is still down at first: wait
+    // for every button to be released before taking any.
+    if (!armed_) {
+      armed_ = buttons == 0;
+      held_ = buttons;
+      return false;
+    }
+    const uint16_t pressed = buttons & ~held_;
+    held_ = buttons;
+    constexpr uint16_t kUpDown = rex::input::X_INPUT_GAMEPAD_DPAD_UP | rex::input::X_INPUT_GAMEPAD_DPAD_DOWN;
+    const double now = ImGui::GetTime();
+    uint16_t steps = pressed & kUpDown;
+    if (steps) {
+      repeat_at_ = now + 0.40;
+    } else if ((buttons & kUpDown) && now >= repeat_at_) {
+      steps = buttons & kUpDown;
+      repeat_at_ = now + 0.12;
+    }
+    if (steps & rex::input::X_INPUT_GAMEPAD_DPAD_UP) Move(-1);
+    if (steps & rex::input::X_INPUT_GAMEPAD_DPAD_DOWN) Move(1);
+    if (pressed & (rex::input::X_INPUT_GAMEPAD_A | rex::input::X_INPUT_GAMEPAD_START)) return Accept();
+    if (pressed & rex::input::X_INPUT_GAMEPAD_Y) return Rename();
+    if (pressed & (rex::input::X_INPUT_GAMEPAD_B | rex::input::X_INPUT_GAMEPAD_BACK)) {
+      Finish(Choice::kCancel);
+      return true;
+    }
+    return false;
+  }
+
+  bool has_opened_ = false;
+  std::string title_;
+  std::vector<rex::system::xam::ProfileEntry> profiles_;
+  std::string error_;
+  size_t selected_ = 0;
+  Choice choice_ = Choice::kCancel;
+  rex::input::InputSystem* input_ = nullptr;
+  bool armed_ = false;
+  uint16_t held_ = 0;
+  double repeat_at_ = 0;
+};
+
+namespace {
+
+std::atomic<bool> profile_picker_up{false};
+
+// Shows a dialog on the UI thread and waits for it to close. False when the UI
+// is gone (the dialog is deleted unseen).
+bool ShowAndWait(rex::ui::ImGuiDialog* dialog) {
+  rex::thread::Fence fence;
+  rex::ui::WindowedAppContext* app_context = REX_KERNEL_STATE()->emulator()->app_context();
+  if (app_context &&
+      app_context->CallInUIThreadSynchronous([&dialog, &fence]() { dialog->Then(&fence); })) {
+    ++xam_dialogs_shown_;
+    fence.Wait();
+    --xam_dialogs_shown_;
+    return true;
+  }
+  delete dialog;
+  return false;
+}
+
+// The player the picker is for: player 1 until signed in, then the player whose
+// controller pressed join, else the first player still signed out.
+uint32_t JoiningPlayer() {
+  auto* kernel_state = REX_KERNEL_STATE();
+  const uint32_t signed_in = kernel_state->signed_in_mask();
+  if (!(signed_in & 1)) {
+    return 0;
+  }
+  auto* input =
+      static_cast<rex::input::InputSystem*>(kernel_state->emulator()->input_system());
+  if (input) {
+    const uint32_t last = input->GetLastUsedUser();
+    if (last < KernelState::kMaxLocalUsers && !(signed_in & (1u << last))) {
+      return last;
+    }
+    const auto connected = input->GetConnectedUsers();
+    for (uint32_t i = 1; i < KernelState::kMaxLocalUsers; ++i) {
+      if (connected[i] && !(signed_in & (1u << i))) {
+        return i;
+      }
+    }
+  }
+  for (uint32_t i = 1; i < KernelState::kMaxLocalUsers; ++i) {
+    if (!(signed_in & (1u << i))) {
+      return i;
+    }
+  }
+  return KernelState::kMaxLocalUsers;
+}
+
+// Asks for a name on the on-screen keyboard. Empty when cancelled.
+std::string AskName(rex::ui::ImGuiDrawer* drawer, const std::string& title,
+                    const std::string& current) {
+  std::string name;
+  auto* keyboard = new KeyboardInputDialog(drawer, title, "", current,
+                                           rex::system::xam::ProfileStore::kMaxNameBytes + 1);
+  keyboard->set_close_callback([&name, keyboard]() {
+    if (!keyboard->cancelled()) {
+      name = std::string(keyboard->text().c_str());  // the text keeps the buffer's padding
+    }
+  });
+  ShowAndWait(keyboard);
+  return name;
+}
+
+// The picker loop for one player: choose a profile, or make or rename one
+// first. Returns once the player is signed in or cancelled.
+void RunProfilePicker(uint32_t user_index) {
+  auto* kernel_state = REX_KERNEL_STATE();
+  auto* store = kernel_state->profile_store();
+  auto* drawer = kernel_state->emulator()->imgui_drawer();
+  if (!store || !drawer) {
+    return;
+  }
+  ScopedGuestInputBlock input_block;
+  std::string error;
+  size_t selected = 0;
+  while (!kernel_state->user_profile(user_index)) {
+    // Profiles another player is using are left out.
+    std::vector<rex::system::xam::ProfileEntry> free;
+    for (auto& profile : store->List()) {
+      if (!kernel_state->user_profile_by_xuid(profile.xuid)) {
+        free.push_back(std::move(profile));
+      }
+    }
+    auto* picker = new ProfilePickerDialog(drawer, user_index, free, error, selected);
+    ProfilePickerDialog::Choice choice = ProfilePickerDialog::Choice::kCancel;
+    size_t index = 0;
+    picker->set_close_callback([&choice, &index, picker]() {
+      choice = picker->choice();
+      index = picker->index();
+    });
+    if (!ShowAndWait(picker)) {
+      return;
+    }
+    error.clear();
+    selected = index;
+    switch (choice) {
+      case ProfilePickerDialog::Choice::kCancel:
+        return;
+      case ProfilePickerDialog::Choice::kPick:
+        if (!kernel_state->SignInUser(user_index, free[index])) {
+          error = "That profile is already playing.";
+        }
+        break;
+      case ProfilePickerDialog::Choice::kNew: {
+        const auto name = AskName(drawer, "New profile name", "");
+        if (name.empty()) {
+          break;
+        }
+        rex::system::xam::ProfileEntry created;
+        error = store->Create(name, &created);
+        if (error.empty()) {
+          kernel_state->SignInUser(user_index, created);
+        }
+        break;
+      }
+      case ProfilePickerDialog::Choice::kRename: {
+        const auto& profile = free[index];
+        const auto name = AskName(drawer, "Rename " + profile.name, profile.name);
+        if (!name.empty()) {
+          error = store->Rename(profile.xuid, name);
+        }
+        break;
+      }
+    }
+  }
+}
