+void KernelState::SignInAtStart() {
+  std::optional<xam::ProfileEntry> chosen;
+  if (const char* wanted = std::getenv("SOTR_PROFILE"); wanted && *wanted) {
+    // The launcher names the profile by XUID.
+    chosen = profile_store_->Find(std::strtoull(wanted, nullptr, 16));
+    if (!chosen) {
+      REXSYS_WARN("profiles: SOTR_PROFILE={} is not a profile in this save folder", wanted);
+    }
+  } else if (std::getenv("SOTR_USERNAME") || REXCVAR_GET(headless)) {
+    // Launchers and scripts from before profiles name the player instead, and
+    // headless runs cannot show the picker.
+    chosen = profile_store_->FindByName(xam::ProfileStore::DefaultName());
+    if (!chosen) {
+      chosen = profile_store_->EnsureDefault();
+    }
+  }
+  if (chosen) {
+    SignInUser(0, *chosen);
+  } else {
+    REXSYS_INFO("profiles: no profile given; player 1 chooses one in game");
+  }
+}
+
+bool KernelState::SignInUser(uint32_t user_index, const xam::ProfileEntry& entry) {
+  if (user_index >= kMaxLocalUsers) {
+    return false;
+  }
+  std::lock_guard lock(profiles_mutex_);
+  if (signed_in_[user_index].load(std::memory_order_acquire) || user_profile_by_xuid(entry.xuid)) {
+    return false;
+  }
+  auto profile = std::make_unique<xam::UserProfile>(entry.xuid, entry.name);
+  profile->set_kernel_state(this);
+  signed_in_[user_index].store(profile.get(), std::memory_order_release);
+  profiles_.push_back(std::move(profile));
+  REXSYS_INFO("profiles: {} ({}) signed in as player {}", entry.name,
+              xam::ProfileStore::XuidText(entry.xuid), user_index + 1);
+  return true;
+}
+
+xam::UserProfile* KernelState::user_profile_by_xuid(uint64_t xuid) const {
+  for (const auto& slot : signed_in_) {
+    auto* profile = slot.load(std::memory_order_acquire);
+    if (profile && profile->xuid() == xuid) {
+      return profile;
+    }
+  }
+  return nullptr;
+}
+
+uint32_t KernelState::signed_in_mask() const {
+  uint32_t mask = 0;
+  for (uint32_t i = 0; i < kMaxLocalUsers; ++i) {
+    if (signed_in_[i].load(std::memory_order_acquire)) {
+      mask |= 1u << i;
+    }
+  }
+  return mask;
+}
