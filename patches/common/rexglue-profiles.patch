+
+void ShowProfilePicker(uint32_t user_index) {
+  auto* kernel_state = REX_KERNEL_STATE();
+  if (REXCVAR_GET(headless) || profile_picker_up.exchange(true)) {
+    return;
+  }
+  if (user_index == kJoiningPlayer) {
+    user_index = JoiningPlayer();
+  }
+  if (user_index >= KernelState::kMaxLocalUsers || kernel_state->user_profile(user_index)) {
+    profile_picker_up = false;
+    return;
+  }
+  // XN_SYS_UI on now; the sign-in change and XN_SYS_UI off once the player has
+  // chosen, as a balanced pair (the title counts these).
+  kernel_state->BroadcastNotification(0x00000009, 1);
+  std::thread([user_index]() {
+    RunProfilePicker(user_index);
+    auto* kernel_state = REX_KERNEL_STATE();
+    kernel_state->BroadcastNotification(0x0000000A, kernel_state->signed_in_mask());
+    rex::thread::Sleep(std::chrono::milliseconds(100));
+    kernel_state->BroadcastNotification(0x00000009, 0);
+    profile_picker_up = false;
+  }).detach();
+}
