+/**
+ * @file        graphics/null/graphics_system.h
+ * @brief       Graphics system without a host graphics API
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+
+namespace rex::graphics::null {
+
+// Executes the guest's GPU command stream (register writes, events, fences, interrupts,
+// swaps) and runs the vblank timer like the other backends, but creates no device,
+// presenter or GPU resources and renders nothing. For apps that draw the guest's frames
+// with their own renderer and present into the window themselves (ReXApp's detached
+// overlay mode; host_presentation off).
+class NullGraphicsSystem : public GraphicsSystem {
+ public:
+  NullGraphicsSystem();
+  ~NullGraphicsSystem() override;
+
+  std::string name() const override { return "null"; }
+
+  // No presenter: the app owns the window's surface.
+  X_STATUS SetupPresentation(::rex::ui::WindowedAppContext* app_context) override;
+
+ protected:
+  void CreateProvider(bool with_presentation) override { (void)with_presentation; }
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override;
+};
+
+}  // namespace rex::graphics::null
