diff --git a/src/graphics/null/graphics_system.cpp b/src/graphics/null/graphics_system.cpp
new file mode 100644
index 0000000..856d381
--- /dev/null
+++ b/src/graphics/null/graphics_system.cpp
@@ -0,0 +1,55 @@
+/**
+ * @file        graphics/null/graphics_system.cpp
+ * @brief       Graphics system without a host graphics API
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/null/graphics_system.h>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::null {
+
+namespace {
+
+// The shared command processor does all the guest-visible work; drawing, copying and
+// presenting are dropped.
+class NullCommandProcessor : public CommandProcessor {
+ public:
+  NullCommandProcessor(GraphicsSystem* graphics_system, system::KernelState* kernel_state)
+      : CommandProcessor(graphics_system, kernel_state) {}
+
+  void IssueSwap(uint32_t, uint32_t, uint32_t) override {}
+
+ protected:
+  bool SetupContext() override { return true; }
+  void ShutdownContext() override {}
+
+  // No shader translation: the active shader pointers are only used by drawing backends.
+  Shader* LoadShader(xenos::ShaderType, uint32_t, const uint32_t*, uint32_t) override {
+    return nullptr;
+  }
+
+  bool IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) override { return true; }
+  bool IssueCopy() override { return true; }
+};
+
+}  // namespace
+
+NullGraphicsSystem::NullGraphicsSystem() = default;
+
+NullGraphicsSystem::~NullGraphicsSystem() = default;
+
+X_STATUS NullGraphicsSystem::SetupPresentation(::rex::ui::WindowedAppContext* app_context) {
+  app_context_ = app_context;
+  REXGPU_INFO("Null graphics backend: no host rendering or presentation");
+  return X_STATUS_SUCCESS;
+}
+
+std::unique_ptr<CommandProcessor> NullGraphicsSystem::CreateCommandProcessor() {
+  return std::make_unique<NullCommandProcessor>(this, kernel_state_);
+}
+
+}  // namespace rex::graphics::null
