+namespace {
+
+// PlayStation pads by USB vendor (Sony, 054C) where SDL's GUID carries one,
+// else by name, which covers Bluetooth pads and drivers that hide the vendor.
+InputSystem::PadFamily ClassifyPad(const DeviceInfo* info) {
+  if (!info) {
+    return InputSystem::PadFamily::kNone;
+  }
+  if (info->synthetic) {
+    return InputSystem::PadFamily::kXbox;  // keyboard and mouse use the Xbox prompts
+  }
+  // SDL GUID text: 16 bytes in hex; bytes 4-5 hold the little-endian vendor id.
+  if (info->guid.size() == 32 && info->guid.compare(8, 4, "4c05") == 0) {
+    return InputSystem::PadFamily::kPlayStation;
+  }
+  std::string name = info->name;
+  for (auto& c : name) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  for (const char* marker : {"dualsense", "dualshock", "playstation", "ps3", "ps4", "ps5"}) {
+    if (name.find(marker) != std::string::npos) {
+      return InputSystem::PadFamily::kPlayStation;
+    }
+  }
+  return InputSystem::PadFamily::kXbox;
+}
+
+}  // namespace
+
+InputSystem::PadFamily InputSystem::ActivePadFamily(uint32_t user_index) const {
+  if (user_index >= kMaxGuestUsers) {
+    return PadFamily::kNone;
+  }
+  return static_cast<PadFamily>(pad_family_[user_index].load(std::memory_order_relaxed));
+}
+
+void InputSystem::UpdatePadFamily(uint32_t user_index, const std::vector<DeviceId>& ids) {
+  if (user_index >= kMaxGuestUsers) {
+    return;
+  }
+  // The pad in hand, as GetCapabilities picks it, else the user's first device.
+  DeviceId chosen = active_devices_.Active(user_index);
+  if (std::find(ids.begin(), ids.end(), chosen) == ids.end()) {
+    chosen = ids.empty() ? DeviceId::kInvalid : ids.front();
+  }
+  if (chosen != DeviceId::kInvalid && chosen == pad_family_device_[user_index]) {
+    return;  // classified already; names and GUIDs do not change
+  }
+  pad_family_device_[user_index] = chosen;
+  pad_family_[user_index].store(static_cast<uint32_t>(ClassifyPad(DeviceInfoFor(chosen))),
+                                std::memory_order_relaxed);
+}
