+bool InputSystem::ClaimPlayerOne(DeviceId id) {
+  player_one_claimed_ = true;
+  auto claimer = std::find_if(devices_.begin(), devices_.end(),
+                              [&](const DeviceInfo& d) { return d.id == id; });
+  if (claimer == devices_.end() || claimer->synthetic || claimer->ordinal == 0) {
+    return false;
+  }
+  // Swap guest users with the pad on player 1, if one is there.
+  for (auto& device : devices_) {
+    if (!device.synthetic && device.ordinal == 0) {
+      device.ordinal = claimer->ordinal;
+      active_devices_.Forget(device.id);
+    }
+  }
+  claimer->ordinal = 0;
+  active_devices_.Forget(id);
+  std::vector<size_t> order(devices_.size());
+  for (size_t i = 0; i < order.size(); i++) {
+    order[i] = i;
+  }
+  std::stable_sort(order.begin(), order.end(),
+                   [&](size_t a, size_t b) { return devices_[a].ordinal < devices_[b].ordinal; });
+  std::vector<DeviceInfo> devices;
+  std::vector<InputDriver*> owners;
+  for (size_t i : order) {
+    devices.push_back(devices_[i]);
+    owners.push_back(device_owners_[i]);
+  }
+  devices_ = std::move(devices);
+  device_owners_ = std::move(owners);
+  if (assignment_) {
+    assignment_->OnDevicesChanged(devices_);
+  }
+  REXLOG_INFO("input: the first pad to press a button is player 1");
+  return true;
+}
