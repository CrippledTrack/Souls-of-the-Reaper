 #include <fmt/format.h>
 
@@ -34,9 +37,18 @@
 #include <rex/stream.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/user_module.h>
+#include <rex/thread.h>
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
+// Guest frame-rate limiter. Diablo III renders uncapped (~100 guest
+// swaps/s) but the host only presents ~44/s; the GPU burns ~100% rendering ROV
+// frames that are dropped before display, which also makes frame pacing (and
+// thus audio) jittery. Pacing the guest swap to a sustainable rate stops the
+// wasted work and smooths delivery. 0 = unlimited (original behaviour).
+REXCVAR_DEFINE_INT32(d3_frame_limit, 0, "GPU",
+                     "Limit guest swap/frame rate to N fps (0 = unlimited)");
+
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Refresh page-valid state from GPU-written memory at frame end. "
                     "Disable for minor CPU overhead reduction, but may break memory coherency.")
@@ -960,6 +972,105 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
 
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
+  // [D3DIAG] Swap probe: distinguish "stuck title" (a) vs "advanced but not
+  // rendered" (b). Logs frontbuffer ptr/size every ~60 swaps, and immediately
+  // whenever the frontbuffer pointer changes (= the guest swapped to a
+  // different framebuffer, i.e. a new screen).
+  {
+    static uint32_t d3_last_fb = 0xFFFFFFFF;
+    if (frontbuffer_ptr != d3_last_fb) {
+      REXGPU_INFO("[D3DIAG] SWAP fb CHANGED {:08X} -> {:08X} ({}x{}) frame#{}",
+                  d3_last_fb, frontbuffer_ptr, frontbuffer_width,
+                  frontbuffer_height, counter_);
+      d3_last_fb = frontbuffer_ptr;
+    } else if ((counter_ % 600) == 0) {
+      REXGPU_INFO("[D3DIAG] SWAP alive fb={:08X} ({}x{}) frame#{}",
+                  frontbuffer_ptr, frontbuffer_width, frontbuffer_height,
+                  counter_);
+    }
+  }
+
+  // Frame limiter + frame-time telemetry.
+  //
+  // Limiter: pace the guest swap to d3_frame_limit fps. Sleeping here (on the
+  // command-processor thread -- confirmed single-threaded for swaps, CLAUDE.md
+  // s11) backpressures the guest render loop via the ring buffer, so the GPU only
+  // renders frames that will be shown. A stable cadence that divides the monitor
+  // refresh (e.g. 30 into 60Hz) also removes present judder: each guest frame
+  // maps to a fixed number of vblanks instead of the presenter dropping vblanks
+  // irregularly under an unstable 90-104fps guest rate. Diablo III on the 360 ran
+  // at 30fps, so 30 is the faithful target. Uses Xenia-canary's proven hybrid
+  // wait: coarse sleep for the bulk of the interval, then a busy-spin tail for
+  // accuracy (immune to OS sleep granularity).
+  //
+  // Telemetry: logs a frame-time histogram (avg/min/max + count of >50ms stutter
+  // spikes) every ~5s. This is the s12 frame-pacing instrument -- variance and
+  // spikes matter for "smoothness", not just average fps. It also runs every
+  // frame so it is always present in the log regardless of d3_frame_limit.
+  {
+    using namespace std::chrono;
+    auto now_ns = []() {
+      return duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count();
+    };
+    int32_t limit = REXCVAR_GET(d3_frame_limit);
+    static int64_t s_next_ns = 0;
+    int64_t t = now_ns();
+    if (limit > 0) {
+      const int64_t interval_ns = int64_t(1000000000LL) / limit;
+      const int64_t spin_margin_ns = 1500000LL;  // busy-spin the last ~1.5ms
+      if (s_next_ns == 0 || t > s_next_ns + interval_ns) {
+        // First swap, or we fell far behind (heavy scene/load) -> resync.
+        s_next_ns = t + interval_ns;
+      } else {
+        const int64_t target = s_next_ns;
+        for (;;) {
+          int64_t remaining = target - now_ns();
+          if (remaining <= 0) break;
+          if (remaining > spin_margin_ns) {
+            std::this_thread::sleep_for(nanoseconds(remaining - spin_margin_ns));
+          }
+          // else: busy-spin (loop re-reads steady_clock) until the target.
+        }
+        s_next_ns += interval_ns;
+      }
+      t = now_ns();  // post-pace timestamp drives the telemetry below
+    } else {
+      s_next_ns = 0;  // reset so a later re-enable resyncs cleanly
+    }
+
+    // Frame-time histogram over a ~5s window.
+    static int64_t s_prev_ns = 0, s_win_ns = 0, s_sum_us = 0, s_min_us = 0, s_max_us = 0;
+    static uint32_t s_frames = 0, s_spikes = 0;
+    static bool s_first = true;
+    if (s_first) {
+      s_first = false;
+      REXGPU_INFO("[D3DIAG s12 pace] frame limiter active, d3_frame_limit={}", limit);
+    }
+    if (s_prev_ns != 0) {
+      int64_t dt_us = (t - s_prev_ns) / 1000;
+      s_sum_us += dt_us;
+      ++s_frames;
+      if (s_min_us == 0 || dt_us < s_min_us) s_min_us = dt_us;
+      if (dt_us > s_max_us) s_max_us = dt_us;
+      if (dt_us > 50000) ++s_spikes;  // >50ms inter-frame = visible stutter
+    }
+    s_prev_ns = t;
+    if (s_win_ns == 0) s_win_ns = t;
+    if (t - s_win_ns >= 5000000000LL && s_frames > 0) {
+      REXGPU_INFO(
+          "[D3DIAG s12 pace] limit={} fps={:.1f} avg={:.2f}ms min={:.2f}ms "
+          "max={:.2f}ms spikes>50ms={}",
+          limit, double(s_frames) * 1e9 / double(t - s_win_ns),
+          double(s_sum_us) / s_frames / 1000.0, s_min_us / 1000.0, s_max_us / 1000.0, s_spikes);
+      s_win_ns = t;
+      s_sum_us = 0;
+      s_frames = 0;
+      s_min_us = 0;
+      s_max_us = 0;
+      s_spikes = 0;
+    }
+  }
+
   ++counter_;
   return true;
 }
