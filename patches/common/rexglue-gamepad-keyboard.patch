+bool SDLInputDriver::GetCombinedGamepad(X_INPUT_STATE* out_state) {
+  // Pumped here because GetDeviceState stops pumping while input is inactive.
+  QueueControllerUpdate();
+  auto guard = DrainAndLock();
+  bool any = false;
+  for (const auto& controller : controllers_) {
+    if (!any) {
+      *out_state = controller.state;
+      any = true;
+    } else {
+      MergeInto(*out_state, controller.state);
+    }
+  }
+  return any;
+}
