+
+void InputSystem::CaptureGamepads(bool capture) {
+  gamepad_captures_.fetch_add(capture ? 1 : -1, std::memory_order_relaxed);
+}
+
+bool InputSystem::DialogGamepad(X_INPUT_GAMEPAD* out) {
+  // drivers_ is fixed after setup, and each driver locks its own devices, so this
+  // is safe on the UI thread while the guest polls.
+  X_INPUT_STATE merged = {};
+  bool any = false;
+  for (auto& driver : drivers_) {
+    X_INPUT_STATE state = {};
+    if (!driver->GetCombinedGamepad(&state)) {
+      continue;
+    }
+    if (!any) {
+      merged = state;
+      any = true;
+    } else {
+      MergeInto(merged, state);
+    }
+  }
+  if (any && out) {
+    *out = merged.gamepad;
+  }
+  return any;
+}
