+// Feasibility harness batch mode: XenosRecomp --batch <list.txt> <out_dir> <header>
+// Each line of list.txt is a shader container path. Prints one RESULT line per shader.
+static int recompileGuarded(ShaderRecompiler& recompiler, const uint8_t* data, std::string_view include)
+{
+    __try { recompiler.recompile(data, include); return 0; }
+    // C++ exceptions (failed asserts) are SEH code 0xE06D7363: let the caller's catch take them.
+    __except (GetExceptionCode() == 0xE06D7363 ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER) { return int(GetExceptionCode()); }
+}
+
+static int runBatch(const char* listPath, const char* outDir, const char* includePath, bool spirvOnly = false)
+{
+    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+    size_t includeSize = 0;
+    auto includeData = readAllBytes(includePath, includeSize);
+    std::string_view include(reinterpret_cast<const char*>(includeData.get()), includeSize);
+    DxcCompiler dxcCompiler;
+    std::ifstream list(listPath);
+    std::string path;
+    while (std::getline(list, path))
+    {
+        if (path.empty())
+            continue;
+        fprintf(stdout, "=== %s\n", path.c_str());
+        fprintf(stderr, "=== %s\n", path.c_str());
+        fflush(stdout);
+        fflush(stderr);
+        size_t fileSize = 0;
+        auto data = readAllBytes(path.c_str(), fileSize);
+        ShaderRecompiler recompiler;
+        std::string result;
+        try
+        {
+            int seh = recompileGuarded(recompiler, data.get(), include);
+            if (seh != 0)
+            {
+                result = fmt::format("crash 0x{:08X}", uint32_t(seh));
+            }
+            else
+            {
+                auto name = std::filesystem::path(path).stem().string();
+                if (!spirvOnly)
+                {
+                    auto hlsl = (std::filesystem::path(outDir) / (name + ".hlsl")).string();
+                    writeAllBytes(hlsl.c_str(), recompiler.out.data(), recompiler.out.size());
+                }
+                IDxcBlob* dxil = spirvOnly ? nullptr : dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, recompiler.specConstantsMask != 0, false);
+                IDxcBlob* spirv = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, false, true);
+                if (spirv)
+                {
+                    // Raw SPIR-V for the experimental renderer, named like the input file.
+                    // Written under a temporary name and renamed, so a reader never sees a
+                    // partial file.
+                    auto spv = std::filesystem::path(outDir) / (name + ".spv");
+                    auto tmp = std::filesystem::path(outDir) / (name + ".spv.tmp");
+                    writeAllBytes(tmp.string().c_str(), spirv->GetBufferPointer(), spirv->GetBufferSize());
+                    std::error_code ec;
+                    std::filesystem::rename(tmp, spv, ec);
+                }
+                result = fmt::format("{} dxil={} spirv={} spec={}", recompiler.isPixelShader ? "ps" : "vs",
+                    dxil ? "ok" : "fail", spirv ? "ok" : "fail", recompiler.specConstantsMask);
+                if (dxil) dxil->Release();
+                if (spirv) spirv->Release();
+            }
+        }
+        catch (const std::exception& e)
+        {
+            result = std::string("exception ") + e.what();
+        }
+        fprintf(stdout, "RESULT %s\n", result.c_str());
+        fflush(stdout);
+        fflush(stderr);
+    }
+    return 0;
+}
+
 int main(int argc, char** argv)
 {
+    if (argc == 5 && strcmp(argv[1], "--batch") == 0)
+        return runBatch(argv[2], argv[3], argv[4]);
+    // Runtime conversion for the game: XenosRecomp --spirv <list.txt> <out_dir> <header>
+    // writes only <out_dir>/<name>.spv per container (no HLSL, no DXIL).
+    if (argc == 5 && strcmp(argv[1], "--spirv") == 0)
+        return runBatch(argv[2], argv[3], argv[4], true);
+    // Debugging: XenosRecomp --hlsl <in.hlsl> <out.spv> <ps|vs> compiles an (edited) HLSL
+    // output to SPIR-V with the same settings as --batch.
+    if (argc == 5 && strcmp(argv[1], "--hlsl") == 0)
+    {
+        size_t size = 0;
+        auto data = readAllBytes(argv[2], size);
+        std::string source(reinterpret_cast<const char*>(data.get()), size);
+        DxcCompiler dxcCompiler;
+        IDxcBlob* spirv = dxcCompiler.compile(source, strcmp(argv[4], "ps") == 0, false, true);
+        if (!spirv)
+            return 1;
+        writeAllBytes(argv[3], spirv->GetBufferPointer(), spirv->GetBufferSize());
+        spirv->Release();
+        return 0;
+    }
 #ifndef XENOS_RECOMP_INPUT
     if (argc < 4)
     {
@@ -209,10 +305,23 @@ int main(int argc, char** argv)
     }
     else
     {
+        // Feasibility harness: HLSL, then DXIL and SPIR-V; exit code says which step failed.
+        SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+        _set_error_mode(_OUT_TO_STDERR);
+        _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
         ShaderRecompiler recompiler;
         size_t fileSize;
-        recompiler.recompile(readAllBytes(input, fileSize).get(), include);
+        auto shaderBytes = readAllBytes(input, fileSize);
+        recompiler.recompile(shaderBytes.get(), include);
         writeAllBytes(output, recompiler.out.data(), recompiler.out.size());
+        DxcCompiler dxcCompiler;
+        IDxcBlob* dxil = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, recompiler.specConstantsMask != 0, false);
+        if (dxil == nullptr) { fputs("STEP dxil FAILED\n", stderr); return 3; }
+        dxil->Release();
+        IDxcBlob* spirv = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, false, true);
+        if (spirv == nullptr) { fputs("STEP spirv FAILED\n", stderr); return 4; }
+        spirv->Release();
+        printf("OK %s spec=%u\n", recompiler.isPixelShader ? "ps" : "vs", recompiler.specConstantsMask);
     }
 
     return 0;
