+// Feasibility harness batch mode: XenosRecomp --batch <list.txt> <out_dir> <header>
+// Each line of list.txt is a shader container path. Prints one RESULT line per shader.
+static int recompileGuarded(ShaderRecompiler& recompiler, const uint8_t* data, std::string_view include)
+{
+    __try { recompiler.recompile(data, include); return 0; }
+    // C++ exceptions (failed asserts) are SEH code 0xE06D7363: let the caller's catch take them.
+    __except (GetExceptionCode() == 0xE06D7363 ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER) { return int(GetExceptionCode()); }
+}
+
+static int runBatch(const char* listPath, const char* outDir, const char* includePath)
+{
+    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+    size_t includeSize = 0;
+    auto includeData = readAllBytes(includePath, includeSize);
+    std::string_view include(reinterpret_cast<const char*>(includeData.get()), includeSize);
+    DxcCompiler dxcCompiler;
+    std::ifstream list(listPath);
+    std::string path;
+    while (std::getline(list, path))
+    {
+        if (path.empty())
+            continue;
+        fprintf(stdout, "=== %s\n", path.c_str());
+        fprintf(stderr, "=== %s\n", path.c_str());
+        fflush(stdout);
+        fflush(stderr);
+        size_t fileSize = 0;
+        auto data = readAllBytes(path.c_str(), fileSize);
+        ShaderRecompiler recompiler;
+        std::string result;
+        try
+        {
+            int seh = recompileGuarded(recompiler, data.get(), include);
+            if (seh != 0)
+            {
+                result = fmt::format("crash 0x{:08X}", uint32_t(seh));
+            }
+            else
+            {
+                auto name = std::filesystem::path(path).stem().string();
+                auto hlsl = (std::filesystem::path(outDir) / (name + ".hlsl")).string();
+                writeAllBytes(hlsl.c_str(), recompiler.out.data(), recompiler.out.size());
+                IDxcBlob* dxil = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, recompiler.specConstantsMask != 0, false);
+                IDxcBlob* spirv = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, false, true);
+                result = fmt::format("{} dxil={} spirv={} spec={}", recompiler.isPixelShader ? "ps" : "vs",
+                    dxil ? "ok" : "fail", spirv ? "ok" : "fail", recompiler.specConstantsMask);
+                if (dxil) dxil->Release();
+                if (spirv) spirv->Release();
+            }
+        }
+        catch (const std::exception& e)
+        {
+            result = std::string("exception ") + e.what();
+        }
+        fprintf(stdout, "RESULT %s\n", result.c_str());
+        fflush(stdout);
+        fflush(stderr);
+    }
+    return 0;
+}
+
